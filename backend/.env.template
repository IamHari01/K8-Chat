# ==============================================================================
# ENTERPRISE AGENTIC RAG - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` and fill in your actual production values.

# --- PORTKEY LLM GATEWAY ---
PORTKEY_API_KEY="your_portkey_api_key_here"
PORTKEY_PRIMARY_CONFIG_ID="your_portkey_config_id_here"

# --- MULTI-KEY GROQ API KEYS (Load Balancing 25% / 25% / 25% / 25%) ---
GROQ_API_KEY_1="gsk_your_first_groq_api_key"
GROQ_API_KEY_2="gsk_your_second_groq_api_key"
GROQ_API_KEY_3="gsk_your_third_groq_api_key"
GROQ_API_KEY_4="gsk_your_fourth_groq_api_key"

# --- PORTKEY VIRTUAL KEYS (Alternative: 4 Virtual Slugs) ---
PORTKEY_VIRTUAL_KEY_1="your_virtual_key_slug_1"
PORTKEY_VIRTUAL_KEY_2="your_virtual_key_slug_2"
PORTKEY_VIRTUAL_KEY_3="your_virtual_key_slug_3"
PORTKEY_VIRTUAL_KEY_4="your_virtual_key_slug_4"

# --- VECTOR DB (Qdrant Cloud) ---
QDRANT_CLUSTER_ENDPOINT="https://your-cluster-id.cloud.qdrant.io"
QDRANT_API_KEY="your_qdrant_api_key_here"

# --- SERVERLESS POSTGRES (Neon Postgres - Agent Memory) ---
NEON_DB_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# --- RATE LIMITING (Upstash Redis) ---
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"

# --- API SAFETY & RATE LIMITS ---
RAG_API_KEY=""
RATE_LIMIT_PER_MINUTE=120

# --- EMBEDDINGS & RERANKER (Jina AI) ---
JINA_API_KEY="your_jina_api_key_here"

# --- OPENAI LLM (Optional) ---
OPENAI_API_KEY=""

# --- OBSERVABILITY (Logfire & LangSmith) ---
LOGFIRE_TOKEN="your_logfire_token_here"
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="kubernetes_rag"